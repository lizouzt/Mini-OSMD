<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<score-partwise version="3.1">
  <part-list>
    <score-part id="P1">
      <part-name>Lyrics Test</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <!-- Measure 1: System 1 -->
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key>
          <fifths>0</fifths>
        </key>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef>
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <print>
        <system-layout>
          <system-margins>
            <left-margin>0</left-margin>
            <right-margin>0</right-margin>
          </system-margins>
          <top-system-distance>20</top-system-distance>
          <system-distance>20</system-distance> <!-- Intentionally small distance to provoke collision -->
        </system-layout>
      </print>
      <note>
        <pitch>
          <step>C</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <type>whole</type>
        <lyric number="1">
          <syllabic>single</syllabic>
          <text>VeryLowHangingLyricsThatMightCollide</text>
        </lyric>
        <lyric number="2">
          <syllabic>single</syllabic>
          <text>SecondLineOfLyricsWhichIsEvenLower</text>
        </lyric>
      </note>
    </measure>

    <!-- Measure 2: System 2 (Forced Break) -->
    <measure number="2">
      <print new-system="yes"/>
      <note>
        <pitch>
          <step>C</step>
          <octave>5</octave>
        </pitch>
        <duration>4</duration>
        <type>whole</type>
      </note>
    </measure>
  </part>
</score-partwise>
